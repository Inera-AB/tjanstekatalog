     ] )
  ] ) ; # 
  fhir:description [ fhir:v "Felsvar från tjänstekatalogens API:er. Varje `issue` bär anropets\nkorrelations-id i standardextensionen\n[operationoutcome-instance-id](http://hl7.org/fhir/extensions/StructureDefinition-operationoutcome-instance-id.html),\nmed anropets `traceparent` enligt [W3C Trace Context](https://www.w3.org/TR/trace-context/)\nsom värde. Se [Felhantering](error-handling.html) och REQ-ERR-1."] ; # 
  fhir:jurisdiction ( [
     fhir:coding ( [
       fhir:system [ fhir:v "urn:iso:std:iso:3166"^^xsd:anyURI ] ;
       fhir:code [ fhir:v "SE" ] ;
       fhir:display [ fhir:v "Sweden" ]
     ] )
  ] ) ; # 
  fhir:fhirVersion [ fhir:v "5.0.0"] ; # 
  fhir:mapping ( [
     fhir:identity [ fhir:v "req" ] ;
     fhir:uri [ fhir:v "https://fhir.inera.se/ig/tjanstekatalog/Requirements/tk-tjanstekatalog-requirements"^^xsd:anyURI ] ;
     fhir:name [ fhir:v "Kravkatalog" ]
  ] [

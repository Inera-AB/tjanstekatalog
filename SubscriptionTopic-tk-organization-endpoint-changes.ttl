  fhir:text [
     fhir:status [ fhir:v "generated" ] ;
     fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Genererad berättande text: SubscriptionTopic tk-organization-endpoint-changes</b></p><a name=\"tk-organization-endpoint-changes\"> </a><a name=\"hctk-organization-endpoint-changes\"> </a><table class=\"grid\"><tr><td><b>SubscriptionTopic</b></td><td>Ändringar i Organisation/Ändpunkt</td></tr><tr><td><b>Description</b></td><td><div><p>Prenumerationsämne (topic) för att låta lokala kataloger prenumerera på förändringar i Organization och Endpoint i tjänstekatalogen, som ett alternativ till periodisk pollning. Klienter skapar en <code>Subscription</code> som refererar detta ämnes url som <code>Subscription.topic</code>. Se &quot;Distribution och synkronisering&quot; i rest-interactions.html för grundladdning (<code>_lastUpdated</code>) och återsynk.</p>\n</div></td></tr><tr><td><b>Upphovsrättsuttalande:</b></td><td> null</td></tr></table><table class=\"grid\"><tr><td colspan=\"3\"><b>Resurstriggers</b></td></tr><tr><th><b>Resurs</b></th><th><b>Interaktioner</b></th><th><b>Beskrivning</b></th></tr><tr><td><a href=\"http://hl7.org/fhir/R5/organization.html\">http://hl7.org/fhir/StructureDefinition/Organization</a></td><td>create, update, delete</td><td><div><p>En organisation skapas, uppdateras eller tas bort.</p>\n</div></td></tr><tr><td><a href=\"http://hl7.org/fhir/R5/endpoint.html\">http://hl7.org/fhir/StructureDefinition/Endpoint</a></td><td>create, update, delete</td><td><div><p>En ändpunkt skapas, uppdateras eller tas bort.</p>\n</div></td></tr></table></div>"^^rdf:XMLLiteral ]

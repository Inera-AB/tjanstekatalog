       ] ;
       fhir:name [ fhir:v "Stödd specifikation (payload profile)" ] ;
       fhir:description [ fhir:v "Kanonisk URL för en interoperabilitetsspecifikation (t.ex. en FHIR IG eller profil) som denna nyttolast/API stödjer. Motsvarar det kommande elementet Endpoint.payload.profile. Kan upprepas om nyttolasten stödjer flera specifikationer eller versioner." ] ;

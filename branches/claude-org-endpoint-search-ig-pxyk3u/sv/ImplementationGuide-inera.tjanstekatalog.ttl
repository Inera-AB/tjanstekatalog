         fhir:reference [ fhir:v "StructureDefinition/tk-endpoint-authorization-server-url" ]
       ] ;
       fhir:name [ fhir:v "URL till auktorisationsserver" ] ;
       fhir:description [ fhir:v "URL till den auktorisationsserver (t.ex. OAuth 2.0-token-endpoint) som klienter ska använda för att erhålla åtkomst till ändpunkten (Ändpunkt.urlTillAuktorisationsserver i informationsunderlaget). Relevant framför allt när Ändpunkt.säkerhetsmetod anger en OAuth 2.0-baserad metod." ] ;
       fhir:isExample [ fhir:v false ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;

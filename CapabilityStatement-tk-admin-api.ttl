@prefix fhir: <http://hl7.org/fhir/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# - resource -------------------------------------------------------------------

<https://fhir.inera.se/ig/tjanstekatalog/CapabilityStatement/tk-admin-api> a fhir:CapabilityStatement ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:id [ fhir:v "tk-admin-api"] ; # 
  fhir:text [
     fhir:status [ fhir:v "extensions" ] ;
     fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Genererad berättande text: CapabilityStatement tk-admin-api</b></p><a name=\"tk-admin-api\"> </a><a name=\"hctk-admin-api\"> </a><h2 id=\"title\">Tjänstekatalogen: administrativt API</h2><ul><li>Implementationsguidens version: 0.1.0 </li><li>FHIR-version: 5.0.0 </li><li>Format som stöds: <code>json</code></li><li>Publicerad: 2026-09-08 </li><li>Publicerad av: Inera AB </li></ul><blockquote class=\"impl-note\"><p><strong>Notera till implementörer: FHIR-förmågor</strong></p><p>Vilken FHIR-förmåga som helst kan vara 'tillåten' av systemet om den inte uttryckligen är markerad som 'SHALL NOT'. Några objekt är markerade som MAY i implementationsguiden för att belysa deras potentiella relevans för användningsfallet.</p></blockquote><h2 id=\"rest\">FHIR RESTful-förmågor</h2><div class=\"panel panel-default\"><div class=\"panel-heading\"><h3 id=\"mode1\" class=\"panel-title\">Mode: <code>server</code></h3></div><div class=\"panel-body\"><div><p>Administrativt API för tjänstekatalogen.</p>\n</div></div></div><h3 id=\"resourcesCap1\">Förmågor per resurs/profil</h3><h4 id=\"resourcesSummary1\">Sammanfattning</h4><p>Sammanfattningstabellen listar resurserna som ingår i denna konfiguration, och för varje resurs listar den:</p><ul><li>De relevanta profilerna (om några)</li><li>Interaktionerna som stöds av varje resurs (<b><span class=\"bg-info\">R</span></b>ead, <b><span class=\"bg-info\">S</span></b>earch, <b><span class=\"bg-info\">U</span></b>pdate, and <b><span class=\"bg-info\">C</span></b>reate, are always shown, while <b><span class=\"bg-info\">VR</span></b>ead, <b><span class=\"bg-info\">P</span></b>atch, <b><span class=\"bg-info\">D</span></b>elete, <b><span class=\"bg-info\">H</span></b>istory on <b><span class=\"bg-info\">I</span></b>nstance, or <b><span class=\"bg-info\">H</span></b>istory on <b><span class=\"bg-info\">T</span></b>yp är endast närvarande om minst en av resurserna har stöd för dem.</li><li><span>De obligatoriska, rekommenderade och vissa valfria sökparametrarna (om några). </span></li><li>De länkade resurserna aktiverade för <code>_include</code></li><li>De övriga resurserna aktiverade för <code>_revinclude</code></li><li>Operationerna på resursen (om några)</li></ul><div class=\"table-responsive\"><table class=\"table table-condensed table-hover\"><thead><tr><th><b>Resurstyp</b></th><th><b>Profil</b></th><th class=\"text-center\"><b title=\"GET en resurs (läs-interaktion)\">R</b></th><th class=\"text-center\"><b title=\"GET alla resurser av typen (sök-interaktion)\">S</b></th><th class=\"text-center\"><b title=\"PUT en ny resursversion (uppdatera-interaktion)\">U</b></th><th class=\"text-center\"><b title=\"POST en ny resurs (skapa-interaktion)\">C</b></th><th><b title=\"Obligatoriska och rekommenderade sökparametrar\">Sökningar</b></th><th><code><b>_include</b></code></th><th><code><b>_revinclude</b></code></th><th><b>Operationer</b></th></tr></thead><tbody><tr><td><a href=\"#Organization1-1\">Organization</a></td><td><a href=\"StructureDefinition-tk-organization.html\">https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-organization</a></td><td class=\"text-center\">y</td><td class=\"text-center\">y</td><td class=\"text-center\">y</td><td class=\"text-center\">y</td><td>identifier, name</td><td/><td/><td/></tr><tr><td><a href=\"#Endpoint1-2\">Endpoint</a></td><td><a href=\"StructureDefinition-tk-endpoint.html\">https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-endpoint</a></td><td class=\"text-center\">y</td><td class=\"text-center\">y</td><td class=\"text-center\">y</td><td class=\"text-center\">y</td><td>organization, listed-by, status</td><td/><td/><td/></tr></tbody></table></div><hr/><div class=\"panel panel-default\"><div class=\"panel-heading\"><h4 id=\"Organization1-1\" class=\"panel-title\"><span style=\"float: right;\">Resurskonformans: unspecified </span>Organization</h4></div><div class=\"panel-body\"><div class=\"container\"><div class=\"row\"><div class=\"col-lg-6\"><span class=\"lead\">Bassystemprofil</span><br/><a href=\"StructureDefinition-tk-organization.html\">Tjänstekatalogen Organization</a></div><div class=\"col-lg-3\"><span class=\"lead\">Profilkonformans</span><br/><b>SHALL</b></div><div class=\"col-lg-3\"><span class=\"lead\">Referenspolicy</span><br/></div></div><p/><div class=\"row\"><div class=\"col-lg-6\"><span class=\"lead\">Interaktionssammanfattning</span><br/><ul><li>Stöder <code>read</code>, <code>search-type</code>, <code>create</code>, <code>update</code>.</li></ul></div></div><p/><div class=\"row\"><div class=\"col-12\"><span class=\"lead\">Dokumentation</span><blockquote><div><p>Organisationer registrerade i tjänstekatalogen.</p>\n</div></blockquote></div></div><div class=\"row\"><div class=\"col-lg-7\"><span class=\"lead\">Sökparametrar</span><table class=\"table table-condensed table-hover\"><thead><tr><th>Konformans</th><th>Parameter</th><th>Typ</th><th>Dokumentation</th></tr></thead><tbody><tr><td><b>SHALL</b></td><td><a href=\"http://hl7.org/fhir/organization.html#search\">identifier</a></td><td><code>token</code></td><td><div><p>Sök organisation på identifierare, t.ex. organisationsnummer.</p>\n</div></td></tr><tr><td><b>SHALL</b></td><td><a href=\"http://hl7.org/fhir/organization.html#search\">name</a></td><td><code>string</code></td><td><div><p>Sök organisation på namn.</p>\n</div></td></tr></tbody></table></div><div class=\"col-lg-5\"> </div></div></div></div></div><div class=\"panel panel-default\"><div class=\"panel-heading\"><h4 id=\"Endpoint1-2\" class=\"panel-title\"><span style=\"float: right;\">Resurskonformans: unspecified </span>Endpoint</h4></div><div class=\"panel-body\"><div class=\"container\"><div class=\"row\"><div class=\"col-lg-6\"><span class=\"lead\">Bassystemprofil</span><br/><a href=\"StructureDefinition-tk-endpoint.html\">Tjänstekatalogen Endpoint</a></div><div class=\"col-lg-3\"><span class=\"lead\">Profilkonformans</span><br/><b>SHALL</b></div><div class=\"col-lg-3\"><span class=\"lead\">Referenspolicy</span><br/></div></div><p/><div class=\"row\"><div class=\"col-lg-6\"><span class=\"lead\">Interaktionssammanfattning</span><br/><ul><li>Stöder <code>read</code>, <code>search-type</code>, <code>create</code>, <code>update</code>.</li></ul></div></div><p/><div class=\"row\"><div class=\"col-12\"><span class=\"lead\">Dokumentation</span><blockquote><div><p>Tekniska ändpunkter registrerade i tjänstekatalogen.</p>\n</div></blockquote></div></div><div class=\"row\"><div class=\"col-lg-7\"><span class=\"lead\">Sökparametrar</span><table class=\"table table-condensed table-hover\"><thead><tr><th>Konformans</th><th>Parameter</th><th>Typ</th><th>Dokumentation</th></tr></thead><tbody><tr><td><b>SHALL</b></td><td><a href=\"http://hl7.org/fhir/endpoint.html#search\">organization</a></td><td><code>reference</code></td><td><div><p>Sök ändpunkter efter förvaltande organisation (Endpoint.managingOrganization, &quot;förvaltar&quot;).</p>\n</div></td></tr><tr><td><b>SHALL</b></td><td><a href=\"SearchParameter-tk-endpoint-listed-by.html\">listed-by</a></td><td><code>reference</code></td><td><div><p>Sök ändpunkter efter organisation som listar dem (Organization.endpoint, &quot;har&quot;). Se SearchParameter-tk-endpoint-listed-by.html.</p>\n</div></td></tr><tr><td><b>SHALL</b></td><td><a href=\"http://hl7.org/fhir/endpoint.html#search\">status</a></td><td><code>token</code></td><td><div><p>Sök ändpunkter efter status.</p>\n</div></td></tr></tbody></table></div><div class=\"col-lg-5\"> </div></div></div></div></div></div>"^^rdf:XMLLiteral ]
  ] ; # 
  fhir:url [ fhir:v "https://fhir.inera.se/ig/tjanstekatalog/CapabilityStatement/tk-admin-api"^^xsd:anyURI] ; # 
  fhir:version [ fhir:v "0.1.0"] ; # 
  fhir:name [ fhir:v "TKAdminAPICapabilityStatement"] ; # 
  fhir:title [ fhir:v "Tjänstekatalogen: administrativt API"] ; # 
  fhir:status [ fhir:v "draft"] ; # 
  fhir:experimental [ fhir:v true] ; # 
  fhir:date [ fhir:v "2026-09-08"^^xsd:date] ; # 
  fhir:publisher [ fhir:v "Inera AB"] ; # 
  fhir:contact ( [
     fhir:name [ fhir:v "Inera AB" ] ;
     fhir:telecom ( [
       fhir:system [ fhir:v "url" ] ;
       fhir:value [ fhir:v "https://www.inera.se" ]
     ] )
  ] ) ; # 
  fhir:description [ fhir:v "Beskriver de FHIR REST-förmågor som tjänstekatalogens administrativa API stödjer: registrering och sökning av organisationer och tekniska ändpunkter, inklusive sökning av ändpunkter per organisation (se [SearchParameter: listed-by](SearchParameter-tk-endpoint-listed-by.html)). Läses av en Synkroniseringstjänst som separat, mot E-hälsomyndighetens (EHM) egna API, antar rollen \"Organization Endpoint Writer\" — se \"Mappning mot EHM:s Organization Endpoint Writer\" i mappings.html."] ; # 
  fhir:jurisdiction ( [
     fhir:coding ( [
       fhir:system [ fhir:v "urn:iso:std:iso:3166"^^xsd:anyURI ] ;
       fhir:code [ fhir:v "SE" ] ;
       fhir:display [ fhir:v "Sweden" ]
     ] )
  ] ) ; # 
  fhir:kind [ fhir:v "requirements"] ; # 
  fhir:fhirVersion [ fhir:v "5.0.0"] ; # 
  fhir:format ( [ fhir:v "json"] ) ; # 
  fhir:rest ( [
     fhir:mode [ fhir:v "server" ] ;
     fhir:documentation [ fhir:v "Administrativt API för tjänstekatalogen." ] ;
     fhir:resource ( [
       fhir:type [ fhir:v "Organization" ] ;
       fhir:profile [
         fhir:v "https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-organization"^^xsd:anyURI ;
         fhir:link <https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-organization>
       ] ;
       fhir:documentation [ fhir:v "Organisationer registrerade i tjänstekatalogen." ] ;
       fhir:interaction ( [
         fhir:code [ fhir:v "read" ]
       ] [
         fhir:code [ fhir:v "search-type" ]
       ] [
         fhir:code [ fhir:v "create" ]
       ] [
         fhir:code [ fhir:v "update" ]
       ] ) ;
       fhir:searchParam ( [
         fhir:name [ fhir:v "identifier" ] ;
         fhir:definition [
           fhir:v "http://hl7.org/fhir/SearchParameter/Organization-identifier"^^xsd:anyURI ;
           fhir:link <http://hl7.org/fhir/SearchParameter/Organization-identifier>
         ] ;
         fhir:type [ fhir:v "token" ] ;
         fhir:documentation [ fhir:v "Sök organisation på identifierare, t.ex. organisationsnummer." ]
       ] [
         fhir:name [ fhir:v "name" ] ;
         fhir:definition [
           fhir:v "http://hl7.org/fhir/SearchParameter/Organization-name"^^xsd:anyURI ;
           fhir:link <http://hl7.org/fhir/SearchParameter/Organization-name>
         ] ;
         fhir:type [ fhir:v "string" ] ;
         fhir:documentation [ fhir:v "Sök organisation på namn." ]
       ] )
     ] [
       fhir:type [ fhir:v "Endpoint" ] ;
       fhir:profile [
         fhir:v "https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-endpoint"^^xsd:anyURI ;
         fhir:link <https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-endpoint>
       ] ;
       fhir:documentation [ fhir:v "Tekniska ändpunkter registrerade i tjänstekatalogen." ] ;
       fhir:interaction ( [
         fhir:code [ fhir:v "read" ]
       ] [
         fhir:code [ fhir:v "search-type" ]
       ] [
         fhir:code [ fhir:v "create" ]
       ] [
         fhir:code [ fhir:v "update" ]
       ] ) ;
       fhir:searchParam ( [
         fhir:name [ fhir:v "organization" ] ;
         fhir:definition [
           fhir:v "http://hl7.org/fhir/SearchParameter/Endpoint-organization"^^xsd:anyURI ;
           fhir:link <http://hl7.org/fhir/SearchParameter/Endpoint-organization>
         ] ;
         fhir:type [ fhir:v "reference" ] ;
         fhir:documentation [ fhir:v "Sök ändpunkter efter förvaltande organisation (Endpoint.managingOrganization, \"förvaltar\")." ]
       ] [
         fhir:name [ fhir:v "listed-by" ] ;
         fhir:definition [
           fhir:v "https://fhir.inera.se/ig/tjanstekatalog/SearchParameter/tk-endpoint-listed-by"^^xsd:anyURI ;
           fhir:link <https://fhir.inera.se/ig/tjanstekatalog/SearchParameter/tk-endpoint-listed-by>
         ] ;
         fhir:type [ fhir:v "reference" ] ;
         fhir:documentation [ fhir:v "Sök ändpunkter efter organisation som listar dem (Organization.endpoint, \"har\"). Se SearchParameter-tk-endpoint-listed-by.html." ]
       ] [
         fhir:name [ fhir:v "status" ] ;
         fhir:definition [
           fhir:v "http://hl7.org/fhir/SearchParameter/Endpoint-status"^^xsd:anyURI ;
           fhir:link <http://hl7.org/fhir/SearchParameter/Endpoint-status>
         ] ;
         fhir:type [ fhir:v "token" ] ;
         fhir:documentation [ fhir:v "Sök ändpunkter efter status." ]
       ] )
     ] )
  ] ) . # 


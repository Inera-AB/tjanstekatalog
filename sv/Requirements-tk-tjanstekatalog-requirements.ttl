@prefix fhir: <http://hl7.org/fhir/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# - resource -------------------------------------------------------------------

<https://fhir.inera.se/ig/tjanstekatalog/Requirements/tk-tjanstekatalog-requirements> a fhir:Requirements ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:id [ fhir:v "tk-tjanstekatalog-requirements"] ; # 
  fhir:language [ fhir:v "sv"] ; # 
  fhir:text [
     fhir:status [ fhir:v "generated" ] ;
     fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Genererad berättande text: Requirements tk-tjanstekatalog-requirements</b></p><a name=\"tk-tjanstekatalog-requirements\"> </a><a name=\"hctk-tjanstekatalog-requirements\"> </a><p>Dessa krav gäller följande aktörer: </p><ul><li><a href=\"ActorDefinition-tk-synkroniseringstjanst.html\">Synkroniseringstjänst</a></li><li><code>http://electronichealth.se/fhir/NDI/ActorDefinition/organization-endpoint-writer-actor-er</code></li></ul><table class=\"grid\"><tr><td><b><a name=\"REQ-SRCH-1\"> </a></b>Sök ändpunkter per organisation (\"har\")</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-conformance-expectation.html#conformance-expectation-SHALL\">SHALL</a></td><td><div><p>Servern SKA stödja sökning av Endpoint-resurser via en sökparameter som returnerar samtliga ändpunkter en angiven organisation listar via <code>Organization.endpoint</code> (\"har\"-relationen), oavsett vilken organisation som tekniskt förvaltar respektive ändpunkt.</p>\n</div><p>Länkar: </p><ul><li>Uppfylld av: <a href=\"https://fhir.inera.se/ig/tjanstekatalog/SearchParameter/tk-endpoint-listed-by\">Endpoint: listed-by</a></li></ul></td></tr><tr><td><b><a name=\"REQ-SRCH-2\"> </a></b>Ändpunktens URL i address</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-conformance-expectation.html#conformance-expectation-SHALL\">SHALL</a></td><td><div><p>Ändpunktens URL SKA anges i <code>Endpoint.address</code>.</p>\n</div><p>Länkar: </p><ul><li>Uppfylld av: <a href=\"https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-endpoint\">Tjänstekatalogen Endpoint</a></li></ul></td></tr><tr><td><b><a name=\"REQ-SRCH-3\"> </a></b>Stödda interoperabilitetsspecifikationer per ändpunkt</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-conformance-expectation.html#conformance-expectation-SHOULD\">SHOULD</a></td><td><div><p>Servern BÖR, per nyttolast (<code>Endpoint.payload</code>) som ändpunkten tillgängliggör, ange vilken/vilka interoperabilitetsspecifikationer (API-specifikationer) nyttolasten följer.</p>\n</div><p>Länkar: </p><ul><li>Uppfylld av: <a href=\"https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-endpoint-payload-profile\">Stödd specifikation (payload profile)</a></li></ul></td></tr><tr><td><b><a name=\"REQ-SRCH-4\"> </a></b>Sök ändpunkter efter stödd interoperabilitetsspecifikation</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-conformance-expectation.html#conformance-expectation-SHOULD\">SHOULD</a></td><td><div><p>Servern BÖR stödja sökning av Endpoint-resurser via en sökparameter (<code>implements</code>) som returnerar samtliga ändpunkter vars nyttolast stödjer en angiven interoperabilitetsspecifikation, som komplement till REQ-SRCH-3:s representation. Tillagt efter jämförelse med en annan implementation av samma problem.</p>\n</div><p>Länkar: </p><ul><li>Uppfylld av: <a href=\"https://fhir.inera.se/ig/tjanstekatalog/SearchParameter/tk-endpoint-implements\">Endpoint: implements</a></li></ul></td></tr><tr><td><b><a name=\"REQ-END-1\"> </a></b>Ändpunkt.id</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-conformance-expectation.html#conformance-expectation-SHALL\">SHALL</a></td><td><div><p>Varje ändpunkt SKA ha ett unikt id.</p>\n</div><p>Länkar: </p><ul><li>Uppfylld av: <a href=\"https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-endpoint\">Tjänstekatalogen Endpoint</a></li></ul></td></tr><tr><td><b><a name=\"REQ-END-2\"> </a></b>Ändpunkt.status</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-conformance-expectation.html#conformance-expectation-SHALL\">SHALL</a></td><td><div><p>Ändpunktens status SKA anges.</p>\n</div><p>Länkar: </p><ul><li>Uppfylld av: <a href=\"https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-endpoint\">Tjänstekatalogen Endpoint</a></li></ul></td></tr><tr><td><b><a name=\"REQ-END-3\"> </a></b>Ändpunkt.namn</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-conformance-expectation.html#conformance-expectation-SHALL\">SHALL</a></td><td><div><p>Ändpunktens namn SKA anges.</p>\n</div><p>Länkar: </p><ul><li>Uppfylld av: <a href=\"https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-endpoint\">Tjänstekatalogen Endpoint</a></li></ul></td></tr><tr><td><b><a name=\"REQ-END-4\"> </a></b>Ändpunkt.adress</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-conformance-expectation.html#conformance-expectation-SHALL\">SHALL</a></td><td><div><p>Ändpunktens URL SKA anges (se även REQ-SRCH-2).</p>\n</div><p>Länkar: </p><ul><li>Uppfylld av: <a href=\"https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-endpoint\">Tjänstekatalogen Endpoint</a></li></ul></td></tr><tr><td><b><a name=\"REQ-END-5\"> </a></b>Ändpunkt.giltigFrom / giltigTom</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-conformance-expectation.html#conformance-expectation-SHOULD\">SHOULD</a></td><td><div><p>Ändpunktens giltighetsperiod BÖR anges.</p>\n</div><p>Länkar: </p><ul><li>Uppfylld av: <a href=\"https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-endpoint\">Tjänstekatalogen Endpoint</a></li></ul></td></tr><tr><td><b><a name=\"REQ-END-6\"> </a></b>Ändpunkt.säkerhetsmetod</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-conformance-expectation.html#conformance-expectation-SHOULD\">SHOULD</a></td><td><div><p>Den säkerhetsmetod som skyddar ändpunkten BÖR anges. Kodverket för detta attribut är i detta utkast preliminärt (example-bindning) — se mappings.html.</p>\n</div><p>Länkar: </p><ul><li>Uppfylld av: <a href=\"https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-endpoint-security-method\">Säkerhetsmetod</a></li></ul></td></tr><tr><td><b><a name=\"REQ-END-7\"> </a></b>Ändpunkt.urlTillAuktorisationsserver</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-conformance-expectation.html#conformance-expectation-SHOULD\">SHOULD</a></td><td><div><p>Om ändpunktens säkerhetsmetod (REQ-END-6) är OAuth 2.0-baserad BÖR URL till auktorisationsserverns token-endpoint anges.</p>\n</div><p>Länkar: </p><ul><li>Uppfylld av: <a href=\"https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-endpoint-authorization-server-url\">URL till auktorisationsserver</a></li></ul></td></tr><tr><td><b><a name=\"REQ-END-8\"> </a></b>Ändpunkt.protokoll</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-conformance-expectation.html#conformance-expectation-SHALL\">SHALL</a></td><td><div><p>Minst ett protokoll som ändpunkten stödjer SKA anges.</p>\n</div><p>Länkar: </p><ul><li>Uppfylld av: <a href=\"https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-endpoint\">Tjänstekatalogen Endpoint</a></li></ul></td></tr><tr><td><b><a name=\"REQ-ORG-1\"> </a></b>Organisation.id / namn</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-conformance-expectation.html#conformance-expectation-SHALL\">SHALL</a></td><td><div><p>Varje organisation SKA ha ett unikt id och ett namn.</p>\n</div><p>Länkar: </p><ul><li>Uppfylld av: <a href=\"https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-organization\">Tjänstekatalogen Organization</a></li></ul></td></tr><tr><td><b><a name=\"REQ-ORG-2\"> </a></b>Organisation.organisationsnummer</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-conformance-expectation.html#conformance-expectation-SHOULD\">SHOULD</a></td><td><div><p>Organisationens organisationsnummer BÖR anges som identifierare. Identifierarsystemets URI är i detta utkast ett antagande i väntan på bekräftelse mot Ineras auktoritativa OID/URI-register — se aliases.fsh.</p>\n</div><p>Länkar: </p><ul><li>Uppfylld av: <a href=\"https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-organization\">Tjänstekatalogen Organization</a></li></ul></td></tr><tr><td><b><a name=\"REQ-ORG-3\"> </a></b>Organisation.endpoint (\"har\")</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-conformance-expectation.html#conformance-expectation-SHALL\">SHALL</a></td><td><div><p>En organisation SKA kunna lista de ändpunkter den \"har\" via <code>Organization.endpoint</code>, sökbart enligt REQ-SRCH-1.</p>\n</div><p>Länkar: </p><ul><li>Uppfylld av: <a href=\"https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-organization\">Tjänstekatalogen Organization</a>, <a href=\"https://fhir.inera.se/ig/tjanstekatalog/SearchParameter/tk-endpoint-listed-by\">Endpoint: listed-by</a></li></ul></td></tr><tr><td><b><a name=\"REQ-ORG-4\"> </a></b>Endpoint.managingOrganization (\"förvaltar\")</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-conformance-expectation.html#conformance-expectation-SHALL\">SHALL</a></td><td><div><p>Varje ändpunkt SKA ange sin förvaltande organisation i <code>Endpoint.managingOrganization</code>, sökbar med standardparametern <code>organization</code>.</p>\n</div><p>Länkar: </p><ul><li>Uppfylld av: <a href=\"https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-endpoint\">Tjänstekatalogen Endpoint</a></li></ul></td></tr><tr><td><b><a name=\"REQ-ORG-5\"> </a></b>Organization.identifier som \"logisk adress\"</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-conformance-expectation.html#conformance-expectation-SHALL\">SHALL</a></td><td><div><p><code>Organization.identifier</code> SKA fungera som den \"logiska adress\" tjänstesökning slår upp, sökbar med standardparametern <code>identifier</code>. Ingen separat identifierare för \"logisk adress\" införs — stakeholder-beslut, se mappings.html.</p>\n</div><p>Länkar: </p><ul><li>Uppfylld av: <a href=\"https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-organization\">Tjänstekatalogen Organization</a>, <a href=\"https://fhir.inera.se/ig/tjanstekatalog/CapabilityStatement/tk-search-api\">Tjänstekatalogen: sök-API (externt)</a></li></ul></td></tr><tr><td><b><a name=\"REQ-WRT-1\"> </a></b>Läsning via tjänstekatalogens admin-API</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-conformance-expectation.html#conformance-expectation-SHALL\">SHALL</a></td><td><div><p>Synkroniseringstjänsten SKA läsa organisationer och ändpunkter via tjänstekatalogens administrativa API, särskilt vilka ändpunkter en organisation listar (REQ-SRCH-1), som underlag för synkroniseringen mot EHM.</p>\n</div><p>Länkar: </p><ul><li>Uppfylld av: <a href=\"https://fhir.inera.se/ig/tjanstekatalog/ActorDefinition/tk-synkroniseringstjanst\">Synkroniseringstjänst</a>, <a href=\"https://fhir.inera.se/ig/tjanstekatalog/CapabilityStatement/tk-admin-api\">Tjänstekatalogen: administrativt API</a></li></ul></td></tr><tr><td><b><a name=\"REQ-WRT-2\"> </a></b>Anropa EHM:s $add-organization</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-conformance-expectation.html#conformance-expectation-MAY\">MAY</a></td><td><div><p>Synkroniseringstjänsten FÅR, i rollen Organization Endpoint Writer hos EHM, koppla en organisation till en ändpunkt genom att anropa POST [ehm-base]/Endpoint/[ehm-id]/$add-organization med organisationens organisationsnummer enligt EHM:s specifikation. Personnummer/samordningsnummer hör till EHM:s patientindex och kombinerade sökningar däremellan — inte till organisationsidentifiering i detta anrop, se REQ-WRT-5. Se mappningstabellen i mappings.html för hur <code>organization</code>-parametern fylls från tjänstekatalogens data.</p>\n</div><p>Länkar: </p><ul><li>Uppfylld av: <a href=\"http://electronichealth.se/fhir/NDI/CapabilityStatement/organization-endpoint-writer-capabilities-er\">http://electronichealth.se/fhir/NDI/CapabilityStatement/organization-endpoint-writer-capabilities-er</a>, <a href=\"http://electronichealth.se/fhir/NDI/OperationDefinition/AddOrganizationToEndpoint\">http://electronichealth.se/fhir/NDI/OperationDefinition/AddOrganizationToEndpoint</a></li></ul></td></tr><tr><td><b><a name=\"REQ-WRT-3\"> </a></b>Anropa EHM:s $remove-organization</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-conformance-expectation.html#conformance-expectation-MAY\">MAY</a></td><td><div><p>Synkroniseringstjänsten FÅR, analogt med REQ-WRT-2, koppla loss en organisation från en ändpunkt genom att anropa POST [ehm-base]/Endpoint/[ehm-id]/$remove-organization.</p>\n</div><p>Länkar: </p><ul><li>Uppfylld av: <a href=\"http://electronichealth.se/fhir/NDI/CapabilityStatement/organization-endpoint-writer-capabilities-er\">http://electronichealth.se/fhir/NDI/CapabilityStatement/organization-endpoint-writer-capabilities-er</a>, <a href=\"http://electronichealth.se/fhir/NDI/OperationDefinition/RemoveOrganizationFromEndpoint\">http://electronichealth.se/fhir/NDI/OperationDefinition/RemoveOrganizationFromEndpoint</a></li></ul></td></tr><tr><td><b><a name=\"REQ-WRT-4\"> </a></b>Korrelation med EHM:s Endpoint-id</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-conformance-expectation.html#conformance-expectation-SHALL\">SHALL</a></td><td><div><p>Varje ändpunkt som ska synkroniseras SKA kunna korreleras med EHM:s eget logiska id för samma ändpunkt i deras register, eftersom $add-organization/$remove-organization adresserar ändpunkten via EHM:s id, inte tjänstekatalogens.</p>\n</div><p>Länkar: </p><ul><li>Uppfylld av: <a href=\"https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-endpoint\">Tjänstekatalogen Endpoint</a></li></ul></td></tr><tr><td><b><a name=\"REQ-WRT-5\"> </a></b>Format på organisationsidentifierare mot EHM</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-conformance-expectation.html#conformance-expectation-SHALL\">SHALL</a></td><td><div><p>Organisationsidentifierare som skickas till EHM:s $add-organization/$remove-organization SKA vara organisationsnummer i det system och format EHM kräver (urn:oid:2.5.4.97, 10 siffror utan bindestreck). Personnummer/samordningsnummer (http://electronichealth.se/identifier/{personnummer|samordningsnummer}) SKA INTE användas för att identifiera en organisation i detta anrop — de hör till EHM:s patientindex och till sökningar som kombinerar tjänstekatalog med patientindex, inte till denna IG:s scope. Se mappningstabellen i mappings.html.</p>\n</div><p>Länkar: </p><ul><li>Uppfylld av: <a href=\"https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-organization\">Tjänstekatalogen Organization</a></li></ul></td></tr><tr><td><b><a name=\"REQ-WRT-6\"> </a></b>FHIR-version och format</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-conformance-expectation.html#conformance-expectation-SHALL\">SHALL</a></td><td><div><p>Tjänstekatalogens administrativa API SKA använda FHIR R5 (5.0.0) och SKA stödja JSON. EHM:s Organization Endpoint Writer-gränssnitt gör detsamma (bekräftat i deras CapabilityStatement).</p>\n</div><p>Länkar: </p><ul><li>Uppfylld av: <a href=\"https://fhir.inera.se/ig/tjanstekatalog/CapabilityStatement/tk-admin-api\">Tjänstekatalogen: administrativt API</a>, <a href=\"http://electronichealth.se/fhir/NDI/CapabilityStatement/organization-endpoint-writer-capabilities-er\">http://electronichealth.se/fhir/NDI/CapabilityStatement/organization-endpoint-writer-capabilities-er</a></li></ul></td></tr><tr><td><b><a name=\"REQ-WRT-7\"> </a></b>Skapa/uppdatera Endpoint hos EHM</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-conformance-expectation.html#conformance-expectation-SHALL\">SHALL</a></td><td><div><p>Innan Synkroniseringstjänsten anropar $add-organization/$remove-organization (REQ-WRT-2/3) SKA motsvarande Endpoint finnas hos EHM, konform med EHM:s profil endpoint-er, mappad enligt mappningstabellen i mappings.html. Observera kardinalitetsskillnaden för payload-specifikationer (EHM tillåter en per payload, denna IG flera) och att säkerhetsmetod/auktorisationsserver-URL kräver kodöversättning respektive strukturell ombyggnad, inte bara värdekopiering.</p>\n</div><p>Länkar: </p><ul><li>Uppfylld av: <a href=\"https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-endpoint\">Tjänstekatalogen Endpoint</a>, <a href=\"http://electronichealth.se/fhir/NDI/StructureDefinition/endpoint-er\">http://electronichealth.se/fhir/NDI/StructureDefinition/endpoint-er</a></li></ul></td></tr><tr><td><b><a name=\"REQ-WRT-8\"> </a></b>Skapa/uppdatera Organization hos EHM</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-conformance-expectation.html#conformance-expectation-SHALL\">SHALL</a></td><td><div><p>Innan Synkroniseringstjänsten kopplar en organisation till en ändpunkt hos EHM SKA organisationen finnas hos EHM, konform med EHM:s profil organization-er, mappad enligt mappningstabellen i mappings.html. Observera att EHM:s Organization.type saknar källa i denna IG:s informationsunderlag (öppen fråga, se mappings.html).</p>\n</div><p>Länkar: </p><ul><li>Uppfylld av: <a href=\"https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-organization\">Tjänstekatalogen Organization</a>, <a href=\"http://electronichealth.se/fhir/NDI/StructureDefinition/organization-er\">http://electronichealth.se/fhir/NDI/StructureDefinition/organization-er</a></li></ul></td></tr><tr><td><b><a name=\"REQ-MDL-1\"> </a></b>Indexpost</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-conformance-expectation.html#conformance-expectation-SHOULD\">SHOULD</a></td><td><div><p>Entiteten Indexpost BÖR modelleras för spårbarhet. REST-exponering (läsning/sökning) i det administrativa API:et är avgränsat bort från detta utkast; direkt skapande/uppdatering från klient är inte avsett, då en indexpost förväntas vara en serverhärledd effekt av registrering av Organisation eller Vård- och omsorgstagare.</p>\n</div><p>Länkar: </p><ul><li>Uppfylld av: <a href=\"https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-indexpost\">Indexpost (logisk modell)</a></li></ul></td></tr><tr><td><b><a name=\"REQ-MDL-2\"> </a></b>Vård- och omsorgstagare</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-conformance-expectation.html#conformance-expectation-SHOULD\">SHOULD</a></td><td><div><p>Entiteten Vård- och omsorgstagare BÖR modelleras för spårbarhet i förhållande till Indexpost.avser. Personuppgifter om vård- och omsorgstagare omfattas inte av detta administrativa API för tjänstekatalogen (teknisk ändpunktskatalog) — se \"Avvikelser och tillägg\" i mappings.html.</p>\n</div><p>Länkar: </p><ul><li>Uppfylld av: <a href=\"https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-vard-och-omsorgstagare\">Vård- och omsorgstagare (logisk modell)</a></li></ul></td></tr><tr><td><b><a name=\"REQ-MDL-3\"> </a></b>API (Ändpunkt tillgängliggör API, API följer API-specifikation)</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-conformance-expectation.html#conformance-expectation-SHALL\">SHALL</a></td><td><div><p>Kopplingen mellan en ändpunkt och de API:er den tillgängliggör, samt vilken/vilka API-specifikationer respektive API följer, SKA kunna uttryckas. Detta realiseras på två komplementära sätt (uppdaterat, se \"Avvikelser och tillägg\" i mappings.html): dels <code>Endpoint.payload</code> tillsammans med extensionen tk-endpoint-payload-profile (snabb, enhops sökbarhet, se REQ-SRCH-3/4), dels en egen resurs, TKAPIInstance (CapabilityStatement kind=instance), som ger \"API\" en egen identitet — se REQ-MDL-6/7 för vad den tillför utöver payload-extensionen.</p>\n</div><p>Länkar: </p><ul><li>Uppfylld av: <a href=\"https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-endpoint\">Tjänstekatalogen Endpoint</a>, <a href=\"https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-endpoint-payload-profile\">Stödd specifikation (payload profile)</a>, <a href=\"https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-api-instance\">Tjänstekatalogen API-instans</a></li></ul></td></tr><tr><td><b><a name=\"REQ-MDL-4\"> </a></b>API-specifikation</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-conformance-expectation.html#conformance-expectation-SHALL\">SHALL</a></td><td><div><p>Entiteten API-specifikation SKA kunna registreras och sökas som en egen resurs. Realiseras som TKAPISpecificationCapability (CapabilityStatement kind=requirements), sökbar på kanonisk url — inte ActorDefinition (EHM:s val för sin motsvarande \"API Specification\"-profil, vilket denna IG avvisar eftersom ActorDefinition är avsett för aktörer, inte specifikationer), inte heller Basic eller ImplementationGuide (denna IG:s tidigare rekommendation, ersatt efter jämförelse med en annan implementation av samma problem — CapabilityStatement.kind=requirements är native FHIR-mekanik för en formell kravbild, och används redan av denna IG:s egna TKAdminAPI/TKSearchAPI). Se \"Avvikelser och tillägg\" i mappings.html.</p>\n</div><p>Länkar: </p><ul><li>Uppfylld av: <a href=\"https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-api-specification-capability\">Tjänstekatalogen API-specifikation</a></li></ul></td></tr><tr><td><b><a name=\"REQ-MDL-5\"> </a></b>Spårbarhet: skapad/senast uppdaterad av</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-conformance-expectation.html#conformance-expectation-SHALL\">SHALL</a></td><td><div><p>Vem som skapade eller senast uppdaterade en post SKA vara spårbart. Tidigare avgränsat bort och uppskjutet till en framtida version (löst med serverloggning och/eller Provenance) — nu realiserat via en obligatorisk Provenance-post per registrering, se REQ-TRC-1/2.</p>\n</div><p>Länkar: </p><ul><li>Uppfylld av: <a href=\"https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-provenance\">Tjänstekatalogen Provenance</a></li></ul></td></tr><tr><td><b><a name=\"REQ-MDL-6\"> </a></b>API-instansens egen giltighetsperiod</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-conformance-expectation.html#conformance-expectation-SHOULD\">SHOULD</a></td><td><div><p>En API-instans (TKAPIInstance) BÖR kunna ange sin egen giltighetsperiod (giltigFrom/giltigTom), oberoende av den tillgängliggörande ändpunktens <code>Endpoint.period</code>. Löser den begränsning som tidigare dokumenterades i mappings.html (\"API:ets egen giltigFrom/giltigTom bärs inte separat\") — basresursen CapabilityStatement saknar ett eget giltighetsperiod-element, löst med en extension.</p>\n</div><p>Länkar: </p><ul><li>Uppfylld av: <a href=\"https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-api-instance-period\">API-instansens giltighetsperiod</a></li></ul></td></tr><tr><td><b><a name=\"REQ-MDL-7\"> </a></b>API-instansens koppling till Ändpunkt och API-specifikation</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-conformance-expectation.html#conformance-expectation-SHALL\">SHALL</a></td><td><div><p>Varje TKAPIInstance SKA referera den ändpunkt som tillgängliggör den (\"tillgängliggör\", via extensionen tk-api-instance-endpoint) och SKA referera den/de API-specifikationer den följer (\"följer\", via <code>CapabilityStatement.instantiates</code>), sökbart via en egen sökparameter (<code>instantiates</code>, eftersom ingen standard-sökparameter finns för detta element).</p>\n</div><p>Länkar: </p><ul><li>Uppfylld av: <a href=\"https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-api-instance\">Tjänstekatalogen API-instans</a>, <a href=\"https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-api-instance-endpoint\">Tillgängliggörande ändpunkt</a>, <a href=\"https://fhir.inera.se/ig/tjanstekatalog/SearchParameter/tk-capabilitystatement-instantiates\">CapabilityStatement: instantiates</a></li></ul></td></tr><tr><td><b><a name=\"REQ-TRC-1\"> </a></b>Provenance krävs vid registrering</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-conformance-expectation.html#conformance-expectation-SHALL\">SHALL</a></td><td><div><p>Varje transaction-Bundle som registrerar (skapar/uppdaterar) en Organization, Endpoint eller CapabilityStatement (API-specifikation/API-instans) SKA innehålla minst en Provenance-post (profilerad som TKProvenance) som via <code>Provenance.target</code> pekar ut den/de registrerade resurserna.</p>\n</div><p>Länkar: </p><ul><li>Uppfylld av: <a href=\"https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-provenance\">Tjänstekatalogen Provenance</a></li></ul></td></tr><tr><td><b><a name=\"REQ-TRC-2\"> </a></b>Registrering via transaction-Bundle</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-conformance-expectation.html#conformance-expectation-SHALL\">SHALL</a></td><td><div><p>Tjänstekatalogens administrativa API SKA stödja systeminteraktionen <code>transaction</code> (en Bundle av typen transaction), så att en registrerad resurs och dess Provenance-post skapas/uppdateras atomiskt tillsammans.</p>\n</div><p>Länkar: </p><ul><li>Uppfylld av: <a href=\"https://fhir.inera.se/ig/tjanstekatalog/CapabilityStatement/tk-admin-api\">Tjänstekatalogen: administrativt API</a></li></ul></td></tr><tr><td><b><a name=\"REQ-EXP-1\"> </a></b>Sök-API exponeras externt via gateway</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-conformance-expectation.html#conformance-expectation-SHALL\">SHALL</a></td><td><div><p>Läsande sökning (read/search-type på Organization/Endpoint) SKA exponeras externt, via en gateway, för sökande konsumenter.</p>\n</div><p>Länkar: </p><ul><li>Uppfylld av: <a href=\"https://fhir.inera.se/ig/tjanstekatalog/CapabilityStatement/tk-search-api\">Tjänstekatalogen: sök-API (externt)</a></li></ul></td></tr><tr><td><b><a name=\"REQ-EXP-2\"> </a></b>Administrativa API:er endast interna</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-conformance-expectation.html#conformance-expectation-SHALL\">SHALL</a></td><td><div><p>Skrivande interaktioner (create/update på Organization/Endpoint/PractitionerRole) SKA vara internt exponerade endast och SKA INTE nås via den externa gatewayen.</p>\n</div><p>Länkar: </p><ul><li>Uppfylld av: <a href=\"https://fhir.inera.se/ig/tjanstekatalog/CapabilityStatement/tk-admin-api\">Tjänstekatalogen: administrativt API</a></li></ul></td></tr><tr><td><b><a name=\"REQ-ADM-1\"> </a></b>Administratörsbehörighetens nivå</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-conformance-expectation.html#conformance-expectation-SHALL\">SHALL</a></td><td><div><p>Varje administratörsbehörighet SKA ange en administrationsnivå (local-admin eller central-admin).</p>\n</div><p>Länkar: </p><ul><li>Uppfylld av: <a href=\"https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-administrator-role\">Tjänstekatalogen administratörsbehörighet</a></li></ul></td></tr><tr><td><b><a name=\"REQ-ADM-2\"> </a></b>Representerad organisation</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-conformance-expectation.html#conformance-expectation-SHALL\">SHALL</a></td><td><div><p>En local-admin-behörighet SKA ange vilken organisation den representerar (<code>TKAdministratorRole.organization</code>), analogt med <code>Endpoint.managingOrganization</code>. En central-admin-behörighet representerar samtliga organisationer och utelämnar medvetet detta element.</p>\n</div><p>Länkar: </p><ul><li>Uppfylld av: <a href=\"https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-administrator-role\">Tjänstekatalogen administratörsbehörighet</a></li></ul></td></tr><tr><td><b><a name=\"REQ-ADM-3\"> </a></b>Behörighetens innehavare</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-conformance-expectation.html#conformance-expectation-SHOULD\">SHOULD</a></td><td><div><p>En administratörsbehörighet BÖR ange vilket konto/system som innehar den.</p>\n</div><p>Länkar: </p><ul><li>Uppfylld av: <a href=\"https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-administrator-role\">Tjänstekatalogen administratörsbehörighet</a></li></ul></td></tr><tr><td><b><a name=\"REQ-DIST-1\"> </a></b>Prenumeration på förändringar (topic-baserad Subscription)</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-conformance-expectation.html#conformance-expectation-SHOULD\">SHOULD</a></td><td><div><p>Servern BÖR stödja R5 topic-baserad <code>Subscription</code> mot ämnet <code>tk-organization-endpoint-changes</code>, så att lokala kataloger kan prenumerera på skapande/uppdatering/borttagning av Organization/Endpoint, som ett alternativ till periodisk pollning.</p>\n</div><p>Länkar: </p><ul><li>Uppfylld av: <a href=\"https://fhir.inera.se/ig/tjanstekatalog/SubscriptionTopic/tk-organization-endpoint-changes\">Ändringar i Organisation/Ändpunkt</a></li></ul></td></tr><tr><td><b><a name=\"REQ-DIST-2\"> </a></b>Grundladdning via _lastUpdated</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-conformance-expectation.html#conformance-expectation-SHOULD\">SHOULD</a></td><td><div><p>Servern BÖR stödja grundladdning och återsynk genom att sökningarna på Organization/Endpoint kan avgränsas med det generella FHIR-sökparametern <code>_lastUpdated</code> (tidsintervall), utan att en separat grundladdnings-operation behöver definieras.</p>\n</div><p>Länkar: </p><ul><li>Uppfylld av: <a href=\"https://fhir.inera.se/ig/tjanstekatalog/CapabilityStatement/tk-admin-api\">Tjänstekatalogen: administrativt API</a></li></ul></td></tr><tr><td><b><a name=\"REQ-DIST-3\"> </a></b>Undvik rundgång — öppen fråga</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-conformance-expectation.html#conformance-expectation-MAY\">MAY</a></td><td><div><p>I en dubbelriktad federerad miljö FÅR ett ursprungsmärke på Organization/Endpoint användas för att undvika att en lokal katalogs egna uppdateringar studsar tillbaka via prenumerationen. Inte löst i detta utkast — se öppen fråga i mappings.html.</p>\n</div></td></tr></table></div>"^^rdf:XMLLiteral ]
  ] ; # 
  fhir:url [ fhir:v "https://fhir.inera.se/ig/tjanstekatalog/Requirements/tk-tjanstekatalog-requirements"^^xsd:anyURI] ; # 
  fhir:version [ fhir:v "0.1.0"] ; # 
  fhir:name [ fhir:v "TKTjanstekatalogRequirements"] ; # 
  fhir:title [ fhir:v "Kravkatalog: Tjänstekatalogen"] ; # 
  fhir:status [ fhir:v "draft"] ; # 
  fhir:experimental [ fhir:v true] ; # 
  fhir:date [ fhir:v "2026-09-08"^^xsd:date] ; # 
  fhir:publisher [ fhir:v "Inera AB"] ; # 
  fhir:contact ( [
     fhir:name [ fhir:v "Inera AB" ] ;
     fhir:telecom ( [
       fhir:system [ fhir:v "url" ] ;
       fhir:value [ fhir:v "https://www.inera.se" ]
     ] )
  ] ) ; # 
  fhir:description [ fhir:v "Formell kravkatalog för tjänstekatalogen. Varje krav spåras till den/de FHIR-artefakt(er) som realiserar det via `satisfiedBy`. Se requirements.html för en läsbar vy och mappings.html för den omvända vyn (attribut → krav)."] ; # 
  fhir:jurisdiction ( [
     fhir:coding ( [
       fhir:system [ fhir:v "urn:iso:std:iso:3166"^^xsd:anyURI ] ;
       fhir:code [ fhir:v "SE" ] ;
       fhir:display [ fhir:v "Sweden" ]
     ] )
  ] ) ; # 
  fhir:actor ( [
     fhir:v "https://fhir.inera.se/ig/tjanstekatalog/ActorDefinition/tk-synkroniseringstjanst"^^xsd:anyURI ;
     fhir:link <https://fhir.inera.se/ig/tjanstekatalog/ActorDefinition/tk-synkroniseringstjanst>
  ] [
     fhir:v "http://electronichealth.se/fhir/NDI/ActorDefinition/organization-endpoint-writer-actor-er"^^xsd:anyURI ;
     fhir:link <http://electronichealth.se/fhir/NDI/ActorDefinition/organization-endpoint-writer-actor-er>
  ] ) ; # 
  fhir:statement ( [
     fhir:key [ fhir:v "REQ-SRCH-1" ] ;
     fhir:label [ fhir:v "Sök ändpunkter per organisation (\"har\")" ] ;
     fhir:conformance ( [ fhir:v "SHALL" ] ) ;
     fhir:requirement [ fhir:v "Servern SKA stödja sökning av Endpoint-resurser via en sökparameter som returnerar samtliga ändpunkter en angiven organisation listar via `Organization.endpoint` (\"har\"-relationen), oavsett vilken organisation som tekniskt förvaltar respektive ändpunkt." ] ;
     fhir:satisfiedBy ( [ fhir:v "https://fhir.inera.se/ig/tjanstekatalog/SearchParameter/tk-endpoint-listed-by"^^xsd:anyURI ] )
  ] [
     fhir:key [ fhir:v "REQ-SRCH-2" ] ;
     fhir:label [ fhir:v "Ändpunktens URL i address" ] ;
     fhir:conformance ( [ fhir:v "SHALL" ] ) ;
     fhir:requirement [ fhir:v "Ändpunktens URL SKA anges i `Endpoint.address`." ] ;
     fhir:satisfiedBy ( [ fhir:v "https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-endpoint"^^xsd:anyURI ] )
  ] [
     fhir:key [ fhir:v "REQ-SRCH-3" ] ;
     fhir:label [ fhir:v "Stödda interoperabilitetsspecifikationer per ändpunkt" ] ;
     fhir:conformance ( [ fhir:v "SHOULD" ] ) ;
     fhir:requirement [ fhir:v "Servern BÖR, per nyttolast (`Endpoint.payload`) som ändpunkten tillgängliggör, ange vilken/vilka interoperabilitetsspecifikationer (API-specifikationer) nyttolasten följer." ] ;
     fhir:satisfiedBy ( [ fhir:v "https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-endpoint-payload-profile"^^xsd:anyURI ] )
  ] [
     fhir:key [ fhir:v "REQ-SRCH-4" ] ;
     fhir:label [ fhir:v "Sök ändpunkter efter stödd interoperabilitetsspecifikation" ] ;
     fhir:conformance ( [ fhir:v "SHOULD" ] ) ;
     fhir:requirement [ fhir:v "Servern BÖR stödja sökning av Endpoint-resurser via en sökparameter (`implements`) som returnerar samtliga ändpunkter vars nyttolast stödjer en angiven interoperabilitetsspecifikation, som komplement till REQ-SRCH-3:s representation. Tillagt efter jämförelse med en annan implementation av samma problem." ] ;
     fhir:satisfiedBy ( [ fhir:v "https://fhir.inera.se/ig/tjanstekatalog/SearchParameter/tk-endpoint-implements"^^xsd:anyURI ] )
  ] [
     fhir:key [ fhir:v "REQ-END-1" ] ;
     fhir:label [ fhir:v "Ändpunkt.id" ] ;
     fhir:conformance ( [ fhir:v "SHALL" ] ) ;
     fhir:requirement [ fhir:v "Varje ändpunkt SKA ha ett unikt id." ] ;
     fhir:satisfiedBy ( [ fhir:v "https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-endpoint"^^xsd:anyURI ] )
  ] [
     fhir:key [ fhir:v "REQ-END-2" ] ;
     fhir:label [ fhir:v "Ändpunkt.status" ] ;
     fhir:conformance ( [ fhir:v "SHALL" ] ) ;
     fhir:requirement [ fhir:v "Ändpunktens status SKA anges." ] ;
     fhir:satisfiedBy ( [ fhir:v "https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-endpoint"^^xsd:anyURI ] )
  ] [
     fhir:key [ fhir:v "REQ-END-3" ] ;
     fhir:label [ fhir:v "Ändpunkt.namn" ] ;
     fhir:conformance ( [ fhir:v "SHALL" ] ) ;
     fhir:requirement [ fhir:v "Ändpunktens namn SKA anges." ] ;
     fhir:satisfiedBy ( [ fhir:v "https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-endpoint"^^xsd:anyURI ] )
  ] [
     fhir:key [ fhir:v "REQ-END-4" ] ;
     fhir:label [ fhir:v "Ändpunkt.adress" ] ;
     fhir:conformance ( [ fhir:v "SHALL" ] ) ;
     fhir:requirement [ fhir:v "Ändpunktens URL SKA anges (se även REQ-SRCH-2)." ] ;
     fhir:satisfiedBy ( [ fhir:v "https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-endpoint"^^xsd:anyURI ] )
  ] [
     fhir:key [ fhir:v "REQ-END-5" ] ;
     fhir:label [ fhir:v "Ändpunkt.giltigFrom / giltigTom" ] ;
     fhir:conformance ( [ fhir:v "SHOULD" ] ) ;
     fhir:requirement [ fhir:v "Ändpunktens giltighetsperiod BÖR anges." ] ;
     fhir:satisfiedBy ( [ fhir:v "https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-endpoint"^^xsd:anyURI ] )
  ] [
     fhir:key [ fhir:v "REQ-END-6" ] ;
     fhir:label [ fhir:v "Ändpunkt.säkerhetsmetod" ] ;
     fhir:conformance ( [ fhir:v "SHOULD" ] ) ;
     fhir:requirement [ fhir:v "Den säkerhetsmetod som skyddar ändpunkten BÖR anges. Kodverket för detta attribut är i detta utkast preliminärt (example-bindning) — se mappings.html." ] ;
     fhir:satisfiedBy ( [ fhir:v "https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-endpoint-security-method"^^xsd:anyURI ] )
  ] [
     fhir:key [ fhir:v "REQ-END-7" ] ;
     fhir:label [ fhir:v "Ändpunkt.urlTillAuktorisationsserver" ] ;
     fhir:conformance ( [ fhir:v "SHOULD" ] ) ;
     fhir:conditionality [ fhir:v true ] ;
     fhir:requirement [ fhir:v "Om ändpunktens säkerhetsmetod (REQ-END-6) är OAuth 2.0-baserad BÖR URL till auktorisationsserverns token-endpoint anges." ] ;
     fhir:satisfiedBy ( [ fhir:v "https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-endpoint-authorization-server-url"^^xsd:anyURI ] )
  ] [
     fhir:key [ fhir:v "REQ-END-8" ] ;
     fhir:label [ fhir:v "Ändpunkt.protokoll" ] ;
     fhir:conformance ( [ fhir:v "SHALL" ] ) ;
     fhir:requirement [ fhir:v "Minst ett protokoll som ändpunkten stödjer SKA anges." ] ;
     fhir:satisfiedBy ( [ fhir:v "https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-endpoint"^^xsd:anyURI ] )
  ] [
     fhir:key [ fhir:v "REQ-ORG-1" ] ;
     fhir:label [ fhir:v "Organisation.id / namn" ] ;
     fhir:conformance ( [ fhir:v "SHALL" ] ) ;
     fhir:requirement [ fhir:v "Varje organisation SKA ha ett unikt id och ett namn." ] ;
     fhir:satisfiedBy ( [ fhir:v "https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-organization"^^xsd:anyURI ] )
  ] [
     fhir:key [ fhir:v "REQ-ORG-2" ] ;
     fhir:label [ fhir:v "Organisation.organisationsnummer" ] ;
     fhir:conformance ( [ fhir:v "SHOULD" ] ) ;
     fhir:requirement [ fhir:v "Organisationens organisationsnummer BÖR anges som identifierare. Identifierarsystemets URI är i detta utkast ett antagande i väntan på bekräftelse mot Ineras auktoritativa OID/URI-register — se aliases.fsh." ] ;
     fhir:satisfiedBy ( [ fhir:v "https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-organization"^^xsd:anyURI ] )
  ] [
     fhir:key [ fhir:v "REQ-ORG-3" ] ;
     fhir:label [ fhir:v "Organisation.endpoint (\"har\")" ] ;
     fhir:conformance ( [ fhir:v "SHALL" ] ) ;
     fhir:requirement [ fhir:v "En organisation SKA kunna lista de ändpunkter den \"har\" via `Organization.endpoint`, sökbart enligt REQ-SRCH-1." ] ;
     fhir:satisfiedBy ( [ fhir:v "https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-organization"^^xsd:anyURI ] [ fhir:v "https://fhir.inera.se/ig/tjanstekatalog/SearchParameter/tk-endpoint-listed-by"^^xsd:anyURI ] )
  ] [
     fhir:key [ fhir:v "REQ-ORG-4" ] ;
     fhir:label [ fhir:v "Endpoint.managingOrganization (\"förvaltar\")" ] ;
     fhir:conformance ( [ fhir:v "SHALL" ] ) ;
     fhir:requirement [ fhir:v "Varje ändpunkt SKA ange sin förvaltande organisation i `Endpoint.managingOrganization`, sökbar med standardparametern `organization`." ] ;
     fhir:satisfiedBy ( [ fhir:v "https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-endpoint"^^xsd:anyURI ] )
  ] [
     fhir:key [ fhir:v "REQ-ORG-5" ] ;
     fhir:label [ fhir:v "Organization.identifier som \"logisk adress\"" ] ;
     fhir:conformance ( [ fhir:v "SHALL" ] ) ;
     fhir:requirement [ fhir:v "`Organization.identifier` SKA fungera som den \"logiska adress\" tjänstesökning slår upp, sökbar med standardparametern `identifier`. Ingen separat identifierare för \"logisk adress\" införs — stakeholder-beslut, se mappings.html." ] ;
     fhir:satisfiedBy ( [ fhir:v "https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-organization"^^xsd:anyURI ] [ fhir:v "https://fhir.inera.se/ig/tjanstekatalog/CapabilityStatement/tk-search-api"^^xsd:anyURI ] )
  ] [
     fhir:key [ fhir:v "REQ-WRT-1" ] ;
     fhir:label [ fhir:v "Läsning via tjänstekatalogens admin-API" ] ;
     fhir:conformance ( [ fhir:v "SHALL" ] ) ;
     fhir:requirement [ fhir:v "Synkroniseringstjänsten SKA läsa organisationer och ändpunkter via tjänstekatalogens administrativa API, särskilt vilka ändpunkter en organisation listar (REQ-SRCH-1), som underlag för synkroniseringen mot EHM." ] ;
     fhir:satisfiedBy ( [ fhir:v "https://fhir.inera.se/ig/tjanstekatalog/ActorDefinition/tk-synkroniseringstjanst"^^xsd:anyURI ] [ fhir:v "https://fhir.inera.se/ig/tjanstekatalog/CapabilityStatement/tk-admin-api"^^xsd:anyURI ] )
  ] [
     fhir:key [ fhir:v "REQ-WRT-2" ] ;
     fhir:label [ fhir:v "Anropa EHM:s $add-organization" ] ;
     fhir:conformance ( [ fhir:v "MAY" ] ) ;
     fhir:requirement [ fhir:v "Synkroniseringstjänsten FÅR, i rollen Organization Endpoint Writer hos EHM, koppla en organisation till en ändpunkt genom att anropa POST [ehm-base]/Endpoint/[ehm-id]/$add-organization med organisationens organisationsnummer enligt EHM:s specifikation. Personnummer/samordningsnummer hör till EHM:s patientindex och kombinerade sökningar däremellan — inte till organisationsidentifiering i detta anrop, se REQ-WRT-5. Se mappningstabellen i mappings.html för hur `organization`-parametern fylls från tjänstekatalogens data." ] ;
     fhir:satisfiedBy ( [ fhir:v "http://electronichealth.se/fhir/NDI/CapabilityStatement/organization-endpoint-writer-capabilities-er"^^xsd:anyURI ] [ fhir:v "http://electronichealth.se/fhir/NDI/OperationDefinition/AddOrganizationToEndpoint"^^xsd:anyURI ] )
  ] [
     fhir:key [ fhir:v "REQ-WRT-3" ] ;
     fhir:label [ fhir:v "Anropa EHM:s $remove-organization" ] ;
     fhir:conformance ( [ fhir:v "MAY" ] ) ;
     fhir:requirement [ fhir:v "Synkroniseringstjänsten FÅR, analogt med REQ-WRT-2, koppla loss en organisation från en ändpunkt genom att anropa POST [ehm-base]/Endpoint/[ehm-id]/$remove-organization." ] ;
     fhir:satisfiedBy ( [ fhir:v "http://electronichealth.se/fhir/NDI/CapabilityStatement/organization-endpoint-writer-capabilities-er"^^xsd:anyURI ] [ fhir:v "http://electronichealth.se/fhir/NDI/OperationDefinition/RemoveOrganizationFromEndpoint"^^xsd:anyURI ] )
  ] [
     fhir:key [ fhir:v "REQ-WRT-4" ] ;
     fhir:label [ fhir:v "Korrelation med EHM:s Endpoint-id" ] ;
     fhir:conformance ( [ fhir:v "SHALL" ] ) ;
     fhir:requirement [ fhir:v "Varje ändpunkt som ska synkroniseras SKA kunna korreleras med EHM:s eget logiska id för samma ändpunkt i deras register, eftersom $add-organization/$remove-organization adresserar ändpunkten via EHM:s id, inte tjänstekatalogens." ] ;
     fhir:satisfiedBy ( [ fhir:v "https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-endpoint"^^xsd:anyURI ] )
  ] [
     fhir:key [ fhir:v "REQ-WRT-5" ] ;
     fhir:label [ fhir:v "Format på organisationsidentifierare mot EHM" ] ;
     fhir:conformance ( [ fhir:v "SHALL" ] ) ;
     fhir:requirement [ fhir:v "Organisationsidentifierare som skickas till EHM:s $add-organization/$remove-organization SKA vara organisationsnummer i det system och format EHM kräver (urn:oid:2.5.4.97, 10 siffror utan bindestreck). Personnummer/samordningsnummer (http://electronichealth.se/identifier/{personnummer|samordningsnummer}) SKA INTE användas för att identifiera en organisation i detta anrop — de hör till EHM:s patientindex och till sökningar som kombinerar tjänstekatalog med patientindex, inte till denna IG:s scope. Se mappningstabellen i mappings.html." ] ;
     fhir:satisfiedBy ( [ fhir:v "https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-organization"^^xsd:anyURI ] )
  ] [
     fhir:key [ fhir:v "REQ-WRT-6" ] ;
     fhir:label [ fhir:v "FHIR-version och format" ] ;
     fhir:conformance ( [ fhir:v "SHALL" ] ) ;
     fhir:requirement [ fhir:v "Tjänstekatalogens administrativa API SKA använda FHIR R5 (5.0.0) och SKA stödja JSON. EHM:s Organization Endpoint Writer-gränssnitt gör detsamma (bekräftat i deras CapabilityStatement)." ] ;
     fhir:satisfiedBy ( [ fhir:v "https://fhir.inera.se/ig/tjanstekatalog/CapabilityStatement/tk-admin-api"^^xsd:anyURI ] [ fhir:v "http://electronichealth.se/fhir/NDI/CapabilityStatement/organization-endpoint-writer-capabilities-er"^^xsd:anyURI ] )
  ] [
     fhir:key [ fhir:v "REQ-WRT-7" ] ;
     fhir:label [ fhir:v "Skapa/uppdatera Endpoint hos EHM" ] ;
     fhir:conformance ( [ fhir:v "SHALL" ] ) ;
     fhir:requirement [ fhir:v "Innan Synkroniseringstjänsten anropar $add-organization/$remove-organization (REQ-WRT-2/3) SKA motsvarande Endpoint finnas hos EHM, konform med EHM:s profil endpoint-er, mappad enligt mappningstabellen i mappings.html. Observera kardinalitetsskillnaden för payload-specifikationer (EHM tillåter en per payload, denna IG flera) och att säkerhetsmetod/auktorisationsserver-URL kräver kodöversättning respektive strukturell ombyggnad, inte bara värdekopiering." ] ;
     fhir:satisfiedBy ( [ fhir:v "https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-endpoint"^^xsd:anyURI ] [ fhir:v "http://electronichealth.se/fhir/NDI/StructureDefinition/endpoint-er"^^xsd:anyURI ] )
  ] [
     fhir:key [ fhir:v "REQ-WRT-8" ] ;
     fhir:label [ fhir:v "Skapa/uppdatera Organization hos EHM" ] ;
     fhir:conformance ( [ fhir:v "SHALL" ] ) ;
     fhir:requirement [ fhir:v "Innan Synkroniseringstjänsten kopplar en organisation till en ändpunkt hos EHM SKA organisationen finnas hos EHM, konform med EHM:s profil organization-er, mappad enligt mappningstabellen i mappings.html. Observera att EHM:s Organization.type saknar källa i denna IG:s informationsunderlag (öppen fråga, se mappings.html)." ] ;
     fhir:satisfiedBy ( [ fhir:v "https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-organization"^^xsd:anyURI ] [ fhir:v "http://electronichealth.se/fhir/NDI/StructureDefinition/organization-er"^^xsd:anyURI ] )
  ] [
     fhir:key [ fhir:v "REQ-MDL-1" ] ;
     fhir:label [ fhir:v "Indexpost" ] ;
     fhir:conformance ( [ fhir:v "SHOULD" ] ) ;
     fhir:requirement [ fhir:v "Entiteten Indexpost BÖR modelleras för spårbarhet. REST-exponering (läsning/sökning) i det administrativa API:et är avgränsat bort från detta utkast; direkt skapande/uppdatering från klient är inte avsett, då en indexpost förväntas vara en serverhärledd effekt av registrering av Organisation eller Vård- och omsorgstagare." ] ;
     fhir:satisfiedBy ( [ fhir:v "https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-indexpost"^^xsd:anyURI ] )
  ] [
     fhir:key [ fhir:v "REQ-MDL-2" ] ;
     fhir:label [ fhir:v "Vård- och omsorgstagare" ] ;
     fhir:conformance ( [ fhir:v "SHOULD" ] ) ;
     fhir:requirement [ fhir:v "Entiteten Vård- och omsorgstagare BÖR modelleras för spårbarhet i förhållande till Indexpost.avser. Personuppgifter om vård- och omsorgstagare omfattas inte av detta administrativa API för tjänstekatalogen (teknisk ändpunktskatalog) — se \"Avvikelser och tillägg\" i mappings.html." ] ;
     fhir:satisfiedBy ( [ fhir:v "https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-vard-och-omsorgstagare"^^xsd:anyURI ] )
  ] [
     fhir:key [ fhir:v "REQ-MDL-3" ] ;
     fhir:label [ fhir:v "API (Ändpunkt tillgängliggör API, API följer API-specifikation)" ] ;
     fhir:conformance ( [ fhir:v "SHALL" ] ) ;
     fhir:requirement [ fhir:v "Kopplingen mellan en ändpunkt och de API:er den tillgängliggör, samt vilken/vilka API-specifikationer respektive API följer, SKA kunna uttryckas. Detta realiseras på två komplementära sätt (uppdaterat, se \"Avvikelser och tillägg\" i mappings.html): dels `Endpoint.payload` tillsammans med extensionen tk-endpoint-payload-profile (snabb, enhops sökbarhet, se REQ-SRCH-3/4), dels en egen resurs, TKAPIInstance (CapabilityStatement kind=instance), som ger \"API\" en egen identitet — se REQ-MDL-6/7 för vad den tillför utöver payload-extensionen." ] ;
     fhir:satisfiedBy ( [ fhir:v "https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-endpoint"^^xsd:anyURI ] [ fhir:v "https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-endpoint-payload-profile"^^xsd:anyURI ] [ fhir:v "https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-api-instance"^^xsd:anyURI ] )
  ] [
     fhir:key [ fhir:v "REQ-MDL-4" ] ;
     fhir:label [ fhir:v "API-specifikation" ] ;
     fhir:conformance ( [ fhir:v "SHALL" ] ) ;
     fhir:requirement [ fhir:v "Entiteten API-specifikation SKA kunna registreras och sökas som en egen resurs. Realiseras som TKAPISpecificationCapability (CapabilityStatement kind=requirements), sökbar på kanonisk url — inte ActorDefinition (EHM:s val för sin motsvarande \"API Specification\"-profil, vilket denna IG avvisar eftersom ActorDefinition är avsett för aktörer, inte specifikationer), inte heller Basic eller ImplementationGuide (denna IG:s tidigare rekommendation, ersatt efter jämförelse med en annan implementation av samma problem — CapabilityStatement.kind=requirements är native FHIR-mekanik för en formell kravbild, och används redan av denna IG:s egna TKAdminAPI/TKSearchAPI). Se \"Avvikelser och tillägg\" i mappings.html." ] ;
     fhir:satisfiedBy ( [ fhir:v "https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-api-specification-capability"^^xsd:anyURI ] )
  ] [
     fhir:key [ fhir:v "REQ-MDL-5" ] ;
     fhir:label [ fhir:v "Spårbarhet: skapad/senast uppdaterad av" ] ;
     fhir:conformance ( [ fhir:v "SHALL" ] ) ;
     fhir:requirement [ fhir:v "Vem som skapade eller senast uppdaterade en post SKA vara spårbart. Tidigare avgränsat bort och uppskjutet till en framtida version (löst med serverloggning och/eller Provenance) — nu realiserat via en obligatorisk Provenance-post per registrering, se REQ-TRC-1/2." ] ;
     fhir:satisfiedBy ( [ fhir:v "https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-provenance"^^xsd:anyURI ] )
  ] [
     fhir:key [ fhir:v "REQ-MDL-6" ] ;
     fhir:label [ fhir:v "API-instansens egen giltighetsperiod" ] ;
     fhir:conformance ( [ fhir:v "SHOULD" ] ) ;
     fhir:requirement [ fhir:v "En API-instans (TKAPIInstance) BÖR kunna ange sin egen giltighetsperiod (giltigFrom/giltigTom), oberoende av den tillgängliggörande ändpunktens `Endpoint.period`. Löser den begränsning som tidigare dokumenterades i mappings.html (\"API:ets egen giltigFrom/giltigTom bärs inte separat\") — basresursen CapabilityStatement saknar ett eget giltighetsperiod-element, löst med en extension." ] ;
     fhir:satisfiedBy ( [ fhir:v "https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-api-instance-period"^^xsd:anyURI ] )
  ] [
     fhir:key [ fhir:v "REQ-MDL-7" ] ;
     fhir:label [ fhir:v "API-instansens koppling till Ändpunkt och API-specifikation" ] ;
     fhir:conformance ( [ fhir:v "SHALL" ] ) ;
     fhir:requirement [ fhir:v "Varje TKAPIInstance SKA referera den ändpunkt som tillgängliggör den (\"tillgängliggör\", via extensionen tk-api-instance-endpoint) och SKA referera den/de API-specifikationer den följer (\"följer\", via `CapabilityStatement.instantiates`), sökbart via en egen sökparameter (`instantiates`, eftersom ingen standard-sökparameter finns för detta element)." ] ;
     fhir:satisfiedBy ( [ fhir:v "https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-api-instance"^^xsd:anyURI ] [ fhir:v "https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-api-instance-endpoint"^^xsd:anyURI ] [ fhir:v "https://fhir.inera.se/ig/tjanstekatalog/SearchParameter/tk-capabilitystatement-instantiates"^^xsd:anyURI ] )
  ] [
     fhir:key [ fhir:v "REQ-TRC-1" ] ;
     fhir:label [ fhir:v "Provenance krävs vid registrering" ] ;
     fhir:conformance ( [ fhir:v "SHALL" ] ) ;
     fhir:requirement [ fhir:v "Varje transaction-Bundle som registrerar (skapar/uppdaterar) en Organization, Endpoint eller CapabilityStatement (API-specifikation/API-instans) SKA innehålla minst en Provenance-post (profilerad som TKProvenance) som via `Provenance.target` pekar ut den/de registrerade resurserna." ] ;
     fhir:satisfiedBy ( [ fhir:v "https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-provenance"^^xsd:anyURI ] )
  ] [
     fhir:key [ fhir:v "REQ-TRC-2" ] ;
     fhir:label [ fhir:v "Registrering via transaction-Bundle" ] ;
     fhir:conformance ( [ fhir:v "SHALL" ] ) ;
     fhir:requirement [ fhir:v "Tjänstekatalogens administrativa API SKA stödja systeminteraktionen `transaction` (en Bundle av typen transaction), så att en registrerad resurs och dess Provenance-post skapas/uppdateras atomiskt tillsammans." ] ;
     fhir:satisfiedBy ( [ fhir:v "https://fhir.inera.se/ig/tjanstekatalog/CapabilityStatement/tk-admin-api"^^xsd:anyURI ] )
  ] [
     fhir:key [ fhir:v "REQ-EXP-1" ] ;
     fhir:label [ fhir:v "Sök-API exponeras externt via gateway" ] ;
     fhir:conformance ( [ fhir:v "SHALL" ] ) ;
     fhir:requirement [ fhir:v "Läsande sökning (read/search-type på Organization/Endpoint) SKA exponeras externt, via en gateway, för sökande konsumenter." ] ;
     fhir:satisfiedBy ( [ fhir:v "https://fhir.inera.se/ig/tjanstekatalog/CapabilityStatement/tk-search-api"^^xsd:anyURI ] )
  ] [
     fhir:key [ fhir:v "REQ-EXP-2" ] ;
     fhir:label [ fhir:v "Administrativa API:er endast interna" ] ;
     fhir:conformance ( [ fhir:v "SHALL" ] ) ;
     fhir:requirement [ fhir:v "Skrivande interaktioner (create/update på Organization/Endpoint/PractitionerRole) SKA vara internt exponerade endast och SKA INTE nås via den externa gatewayen." ] ;
     fhir:satisfiedBy ( [ fhir:v "https://fhir.inera.se/ig/tjanstekatalog/CapabilityStatement/tk-admin-api"^^xsd:anyURI ] )
  ] [
     fhir:key [ fhir:v "REQ-ADM-1" ] ;
     fhir:label [ fhir:v "Administratörsbehörighetens nivå" ] ;
     fhir:conformance ( [ fhir:v "SHALL" ] ) ;
     fhir:requirement [ fhir:v "Varje administratörsbehörighet SKA ange en administrationsnivå (local-admin eller central-admin)." ] ;
     fhir:satisfiedBy ( [ fhir:v "https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-administrator-role"^^xsd:anyURI ] )
  ] [
     fhir:key [ fhir:v "REQ-ADM-2" ] ;
     fhir:label [ fhir:v "Representerad organisation" ] ;
     fhir:conformance ( [ fhir:v "SHALL" ] ) ;
     fhir:conditionality [ fhir:v true ] ;
     fhir:requirement [ fhir:v "En local-admin-behörighet SKA ange vilken organisation den representerar (`TKAdministratorRole.organization`), analogt med `Endpoint.managingOrganization`. En central-admin-behörighet representerar samtliga organisationer och utelämnar medvetet detta element." ] ;
     fhir:satisfiedBy ( [ fhir:v "https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-administrator-role"^^xsd:anyURI ] )
  ] [
     fhir:key [ fhir:v "REQ-ADM-3" ] ;
     fhir:label [ fhir:v "Behörighetens innehavare" ] ;
     fhir:conformance ( [ fhir:v "SHOULD" ] ) ;
     fhir:requirement [ fhir:v "En administratörsbehörighet BÖR ange vilket konto/system som innehar den." ] ;
     fhir:satisfiedBy ( [ fhir:v "https://fhir.inera.se/ig/tjanstekatalog/StructureDefinition/tk-administrator-role"^^xsd:anyURI ] )
  ] [
     fhir:key [ fhir:v "REQ-DIST-1" ] ;
     fhir:label [ fhir:v "Prenumeration på förändringar (topic-baserad Subscription)" ] ;
     fhir:conformance ( [ fhir:v "SHOULD" ] ) ;
     fhir:requirement [ fhir:v "Servern BÖR stödja R5 topic-baserad `Subscription` mot ämnet `tk-organization-endpoint-changes`, så att lokala kataloger kan prenumerera på skapande/uppdatering/borttagning av Organization/Endpoint, som ett alternativ till periodisk pollning." ] ;
     fhir:satisfiedBy ( [ fhir:v "https://fhir.inera.se/ig/tjanstekatalog/SubscriptionTopic/tk-organization-endpoint-changes"^^xsd:anyURI ] )
  ] [
     fhir:key [ fhir:v "REQ-DIST-2" ] ;
     fhir:label [ fhir:v "Grundladdning via _lastUpdated" ] ;
     fhir:conformance ( [ fhir:v "SHOULD" ] ) ;
     fhir:requirement [ fhir:v "Servern BÖR stödja grundladdning och återsynk genom att sökningarna på Organization/Endpoint kan avgränsas med det generella FHIR-sökparametern `_lastUpdated` (tidsintervall), utan att en separat grundladdnings-operation behöver definieras." ] ;
     fhir:satisfiedBy ( [ fhir:v "https://fhir.inera.se/ig/tjanstekatalog/CapabilityStatement/tk-admin-api"^^xsd:anyURI ] )
  ] [
     fhir:key [ fhir:v "REQ-DIST-3" ] ;
     fhir:label [ fhir:v "Undvik rundgång — öppen fråga" ] ;
     fhir:conformance ( [ fhir:v "MAY" ] ) ;
     fhir:requirement [ fhir:v "I en dubbelriktad federerad miljö FÅR ett ursprungsmärke på Organization/Endpoint användas för att undvika att en lokal katalogs egna uppdateringar studsar tillbaka via prenumerationen. Inte löst i detta utkast — se öppen fråga i mappings.html." ]
  ] ) . # 


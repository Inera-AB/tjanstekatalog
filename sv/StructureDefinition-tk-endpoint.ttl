  fhir:version [ fhir:v "0.1.0"] ; # 
  fhir:name [ fhir:v "TKEndpoint"] ; # 
  fhir:title [ fhir:v "Tjänstekatalogen Endpoint"] ; # 
  fhir:status [ fhir:v "draft"] ; # 

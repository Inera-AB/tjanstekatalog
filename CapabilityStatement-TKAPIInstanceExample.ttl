<https://fhir.inera.se/ig/tjanstekatalog/CapabilityStatement/TKAPIInstanceExample> a fhir:CapabilityStatement ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:id [ fhir:v "TKAPIInstanceExample"] ; # 
